# Supabase (frontend — anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (server-side only — NEVER expose in frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business Platform / Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# API interna (protege /api/whatsapp/send)
INTERNAL_API_KEY=

# Stripe (billing)
# 1. Cole sua chave secreta de teste (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=
# 2. Rode: npm run stripe:setup  (cria produtos/prices e preenche os IDs abaixo)
STRIPE_PRICE_ESSENCIAL_MONTHLY=
STRIPE_PRICE_ESSENCIAL_YEARLY=
STRIPE_PRICE_PROFISSIONAL_MONTHLY=
STRIPE_PRICE_PROFISSIONAL_YEARLY=
# 3. Webhook: Dashboard → Webhooks → endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# OpenAI (respostas WhatsApp IA)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App
APP_URL=
VITE_APP_URL=
